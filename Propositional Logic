function TT-CHECK-ALL(KB, query, symbols, model):
    if symbols is empty:
        if PL-TRUE(KB, model):
            return PL-TRUE(query, model)   // KB true, so query must be true
        else:
            return true                    // KB false, so model is irrelevant
    else:
        P ← first(symbols)
        rest ← remaining(symbols)
        return TT-CHECK-ALL(KB, query, rest, model ∪ {P = true})
           and TT-CHECK-ALL(KB, query, rest, model ∪ {P = false})

function PL-TRUE(sentence, model):
    if sentence is a symbol:        return model[sentence]
