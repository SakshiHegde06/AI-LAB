import random
import math

def calculate_conflicts(state):
    """Calculates the number of conflicting queen pairs on the board."""
    n = len(state)
    conflicts = 0
    for i in range(n):
        for j in range(i + 1, n):
            # Same row conflict
            if state[i] == state[j]:
                conflicts += 1
            # Diagonal conflict
            elif abs(state[i] - state[j]) == abs(i - j):
                conflicts += 1
    return conflicts

def get_neighbor(state):
    """Generates a neighbor state by randomly moving one queen to a different row."""
    neighbor = list(state)
    n = len(neighbor)
    col = random.randint(0, n - 1)
    row = random.randint(0, n - 1)
    # Ensure we actually move the queen to a new row
    while row == neighbor[col]:
        row = random.randint(0, n - 1)
    neighbor[col] = row
    return neighbor

def simulated_annealing_n_queens(n=8, init_temp=100.0, cooling_rate=0.99, max_iter=10000):
    """Solves the N-Queens problem using Simulated Annealing."""
    # Start with a random initial state
    current_state = [random.randint(0, n - 1) for _ in range(n)]
    current_energy = calculate_conflicts(current_state)
    
    temp = init_temp
    
    for iteration in range(max_iter):
        # If no conflicts, we found a solution
        if current_energy == 0:
            return current_state, iteration

        # Get a random neighbor configuration
        neighbor = get_neighbor(current_state)
        neighbor_energy = calculate_conflicts(neighbor)
        
        # Calculate change in energy (cost)
        delta_e = neighbor_energy - current_energy
        
        # If neighbor is better, accept it. 
        # If worse, accept it with a probability determined by temperature.
        if delta_e < 0 or random.random() < math.exp(-delta_e / temp):
            current_state = neighbor
            current_energy = neighbor_energy
            
        # Cool down the system
        temp *= cooling_rate
        
        # Stop if temperature gets too low
        if temp < 0.00001:
            break
            
    return current_state, iteration

def print_board(state):
    """Helper to visualize the board arrangement."""
    n = len(state)
    for row in range(n):
        line = ""
        for col in range(n):
            if state[col] == row:
                line += " Q "
            else:
                line += " . "
        print(line)

# --- Execution ---
if __name__ == "__main__":
    N = 8  # Change this to scale the board size (e.g., 16, 20)
    print(f"Solving {N}-Queens using Simulated Annealing...")
    
    solution, iterations = simulated_annealing_n_queens(n=N)
    final_conflicts = calculate_conflicts(solution)
    
    print(f"\nFinished after {iterations} iterations.")
    print(f"Remaining conflicts: {final_conflicts}")
    print(f"Solution State (Row positions per Column): {solution}\n")
    
    if final_conflicts == 0:
        print("Success! Visual board layout:")
        print_board(solution)
    else:
        print("Failed to find a perfect solution within the iteration limits. Try adjusting hyperparameters.")



